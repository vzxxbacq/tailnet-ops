#!/usr/bin/env python3
"""tn: the tailnet-ops command. Run from the repository: ./tn --help"""

import sys

sys.dont_write_bytecode = True
if sys.version_info < (3, 11):
    # A shell alias such as python3=python3.12 never reaches "#!/usr/bin/env python3",
    # so look for a newer Python on PATH before giving up.
    import os
    import shutil

    if not os.environ.get("TN_REEXEC"):
        for name in ("python3.14", "python3.13", "python3.12", "python3.11"):
            found = shutil.which(name)
            if found:
                os.environ["TN_REEXEC"] = "1"
                os.execv(found, [found] + sys.argv)
    sys.exit("tn needs Python 3.11 or newer (for tomllib), e.g. brew install python@3.12")

from pathlib import Path  # noqa: E402

sys.path.insert(0, str(Path(__file__).resolve().parent))

from tailnet_ops.cli import main  # noqa: E402

sys.exit(main())
